# ─────────────────────────────────────────────────────────
# Valores de ejemplo para levantar el sistema con `docker compose up`.
#
# Estas credenciales son solo para desarrollo local: cámbialas antes de
# exponer el sistema fuera de tu máquina. Docker Compose lee este archivo
# automáticamente y sustituye las referencias ${...} del compose.
# ─────────────────────────────────────────────────────────

# Credenciales de las bases PostgreSQL. Las tres bases usan estas mismas
# credenciales, pero viven en instancias y bases distintas: cada servicio
# es dueño exclusivo de la suya.
POSTGRES_USER=kite
POSTGRES_PASSWORD=kite123

# Puerto del host donde se publica el API Gateway. Es el único puerto
# expuesto: los servicios de negocio quedan dentro de la red de Docker.
GATEWAY_HTTP_PORT=8080
